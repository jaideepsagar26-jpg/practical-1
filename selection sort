#include <iostream>
#include <vector>
#include <algorithm> // For std::swap

// Function to print the partitions cleanly
void printPartitions(const std::vector<int>& arr, int sortedBoundary) {
    std::cout << "Sorted: [ ";
    for (int i = 0; i < sortedBoundary; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << "] | Unsorted: [ ";
    for (size_t i = sortedBoundary; i < arr.size(); ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << "]\n";
}

// Function to perform Selection Sort
void selectionSort(std::vector<int>& arr) {
    int n = arr.size();

    // The outer loop establishes the boundary of the sorted region
    for (int i = 0; i < n - 1; ++i) {
        std::cout << "\n--- Step " << i + 1 << " ---\n";
        printPartitions(arr, i);

        // Assume the first element of the unsorted section is the minimum
        int min_index = i;

        // The inner loop scans the remaining unsorted part to find the actual minimum
        for (int j = i + 1; j < n; ++j) {
            if (arr[j] < arr[min_index]) {
                min_index = j; // Update index of the lower value
            }
        }

        // Swap the found minimum element with the first unsorted element
        if (min_index != i) {
            std::cout << "Swapping " << arr[i] << " with minimum element " << arr[min_index] << "\n";
            std::swap(arr[i], arr[min_index]);
        } else {
            std::cout << "Element " << arr[i] << " is already in the correct position.\n";
        }
    }
}

int main() {
    std::vector<int> data = {29, 10, 14, 37, 13};

    std::cout << "=== INITIAL ARRAY ===\n";
    printPartitions(data, 0);

    selectionSort(data);

    std::cout << "\n=== FINAL SORTED ARRAY ===\n";
    printPartitions(data, data.size());

    return 0;
}
